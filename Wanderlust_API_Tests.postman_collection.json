    {
      "name": "Tour Packages",
      "item": [
        {
          "name": "Get All Packages",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response contains packages\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('results');",
                  "    pm.expect(jsonData.results.length).to.be.greaterThan(0);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/packages/",
              "host": ["{{base_url}}"],
              "path": ["packages", ""]
            }
          }
        },
        {
          "name": "Filter Packages - Easy Difficulty",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Only easy difficulty packages\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    jsonData.results.forEach(function(pkg) {",
                  "        pm.expect(pkg.difficulty).to.equal('easy');",
                  "    });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/packages/?difficulty=easy",
              "host": ["{{base_url}}"],
              "path": ["packages", ""],
              "query": [
                {
                  "key": "difficulty",
                  "value": "easy"
                }
              ]
            }
          }
        },
        {
          "name": "Filter Packages - Price Range",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Prices within range\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    jsonData.results.forEach(function(pkg) {",
                  "        pm.expect(pkg.price).to.be.greaterThanOrEqualTo(500);",
                  "        pm.expect(pkg.price).to.be.lessThanOrEqualTo(1500);",
                  "    });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/packages/?min_price=500&max_price=1500",
              "host": ["{{base_url}}"],
              "path": ["packages", ""],
              "query": [
                {
                  "key": "min_price",
                  "value": "500"
                },
                {
                  "key": "max_price",
                  "value": "1500"
                }
              ]
            }
          }
        },
        {
          "name": "Get Package Details",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
