# ============================================================================
# Django Settings
# ============================================================================

# Environment: 'development' or 'production'
ENVIRONMENT=development

# Django secret key (generate a new one for production)
# Run: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

# Debug mode (always False in production)
DEBUG=True

# Allowed hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# ============================================================================
# Database Configuration
# ============================================================================

# SQLite (Development default)
# Uses db.sqlite3 by default when using SQLite

# PostgreSQL (Production recommended)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=tours_db
DB_USER=postgres
DB_PASSWORD=your-secure-password
DB_HOST=localhost
DB_PORT=5432

# Alternative: Use DATABASE_URL (parsed by dj-database-url)
# DATABASE_URL=postgresql://user:password@localhost:5432/tours_db

# ============================================================================
# Email Configuration
# ============================================================================

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-specific-password
DEFAULT_FROM_EMAIL=noreply@tours.com

# ============================================================================
# Google Gemini API (AI Chatbot - Aria)
# ============================================================================

# Get your key at: https://aistudio.google.com/app/apikey
# Click "Create API Key" and copy the key here
GOOGLE_API_KEY=your-google-api-key-here

# ============================================================================
# Security & HTTPS
# ============================================================================

# SSL/HTTPS settings (production only)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# ============================================================================
# Caching (Redis)
# ============================================================================

REDIS_URL=redis://localhost:6379/1

# ============================================================================
# Logging
# ============================================================================

DJANGO_LOG_LEVEL=INFO

# ============================================================================
# Admin Configuration
# ============================================================================

# Format: "Name|email@domain.com;Name2|email2@domain.com"
ADMINS=

# ============================================================================
# AWS S3 Configuration (Optional - for static/media files)
# ============================================================================

# USE_S3=False
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_STORAGE_BUCKET_NAME=your-bucket-name
# AWS_S3_REGION_NAME=us-east-1

# ============================================================================
# Sentry Configuration (Optional - Error Tracking)
# ============================================================================

# SENTRY_DSN=your-sentry-dsn-here

# ============================================================================
# API Configuration (Optional)
# ============================================================================

# API_RATE_LIMIT=1000/hour
# CORS_ALLOWED_ORIGINS=http://localhost:3000,https://frontend.com
